# Brightloop SMS — Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env to Git.

# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL connection (used by config/settings.py).
# Leave DB_NAME empty (or delete these lines) to use a local SQLite file instead.
DB_NAME=brightloop
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for hosted databases such as Neon
DB_SSLMODE=prefer
